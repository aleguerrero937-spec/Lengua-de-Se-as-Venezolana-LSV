<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LSV - Lengua de Señas Venezolana</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&display=swap" rel="stylesheet">
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
:root {
  --primary: #0a1628;
  --secondary: #c53030;
  --accent: #d69e2e;
  --accent-light: #f6e05e;
  --bg: #fafafa;
  --text: #1a202c;
  --text-light: #4a5568;
  --text-muted: #718096;
  --border: #e2e8f0;
}
html { scroll-behavior: auto; }
body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
header {
  background: rgba(10, 22, 40, 0.98);
  backdrop-filter: blur(20px);
  color: white;
  padding: 0 40px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 70px;
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  border-bottom: 1px solid rgba(255,255,255,0.05);
}
header.hidden { transform: translateY(-100%); }
.logo {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 1.2em;
  font-weight: 700;
  cursor: pointer;
}
.logo-flag {
  width: 40px; height: 28px;
  border-radius: 4px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.15);
}
.menu-btn {
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
  display: flex;
  flex-direction: column;
  gap: 5px;
}
.menu-btn span {
  display: block;
  width: 24px; height: 2px;
  background: white;
  border-radius: 2px;
  transition: all 0.3s;
}
.menu-btn.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
.menu-btn.active span:nth-child(2) { opacity: 0; }
.menu-btn.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }
.side-panel {
  position: fixed;
  top: 0; right: -400px;
  width: 380px;
  max-width: 85vw;
  height: 100vh;
  background: white;
  z-index: 2000;
  transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: -10px 0 40px rgba(0,0,0,0.15);
  overflow-y: auto;
}
.side-panel.open { right: 0; }
.panel-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1500;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}
.panel-overlay.open { opacity: 1; pointer-events: all; }
.panel-header {
  padding: 25px 30px;
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.panel-header h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.3em;
  color: var(--primary);
}
.panel-close {
  background: none;
  border: none;
  cursor: pointer;
  padding: 5px;
  color: var(--text-muted);
}
.panel-content { padding: 10px 0; }
.panel-item {
  padding: 20px 30px;
  cursor: pointer;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  gap: 18px;
  border-left: 3px solid transparent;
}
.panel-item:hover {
  background: var(--bg);
  border-left-color: var(--accent);
}
.panel-item-icon {
  width: 36px; height: 36px;
  border-radius: 8px;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.panel-item-icon svg { width: 18px; height: 18px; stroke: var(--primary); }
.panel-item-text { font-size: 1em; color: var(--text); font-weight: 500; }
.panel-item-sub { font-size: 0.82em; color: var(--text-muted); margin-top: 3px; }
.panel-submenu {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s ease;
  background: var(--bg);
}
.panel-submenu.open { max-height: 500px; }
.panel-sub-item {
  padding: 14px 30px 14px 84px;
  cursor: pointer;
  font-size: 0.9em;
  color: var(--text-light);
  transition: all 0.2s;
  display: flex;
  align-items: center;
  gap: 12px;
}
.panel-sub-item:hover {
  color: var(--primary);
  background: rgba(214,158,46,0.05);
}
.panel-sub-item .sub-number {
  font-family: 'Playfair Display', serif;
  font-size: 0.85em;
  color: var(--text-muted);
  min-width: 20px;
}
.panel-divider { height: 1px; background: var(--border); margin: 8px 30px; }
.hero {
  background: var(--primary);
  color: white;
  padding: 160px 40px 90px;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: 
    radial-gradient(circle at 15% 50%, rgba(214,158,46,0.08) 0%, transparent 50%),
    radial-gradient(circle at 85% 50%, rgba(197,48,48,0.08) 0%, transparent 50%);
}
.hero-content { position: relative; z-index: 1; max-width: 900px; margin: 0 auto; }
.hero .eyebrow {
  display: inline-block;
  font-size: 0.8em;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--accent-light);
  margin-bottom: 20px;
  font-weight: 600;
}
.hero h1 {
  font-family: 'Playfair Display', serif;
  font-size: 3.8em;
  font-weight: 900;
  margin-bottom: 10px;
  letter-spacing: -1.5px;
  line-height: 1.1;
}
.hero h1 em {
  color: var(--accent-light);
  font-style: italic;
  font-weight: 700;
}
.hero-stats {
  display: flex;
  justify-content: center;
  gap: 35px;
  margin-top: 35px;
  flex-wrap: wrap;
}
.stat { display: flex; align-items: baseline; gap: 6px; }
.stat-number {
  font-size: 1.4em;
  font-weight: 800;
  color: var(--accent-light);
  font-family: 'Playfair Display', serif;
  line-height: 1;
}
.stat-label {
  font-size: 0.75em;
  opacity: 0.6;
  font-weight: 400;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}
.container { max-width: 1300px; margin: 0 auto; padding: 80px 40px; }
.section-header { margin-bottom: 50px; max-width: 700px; }
.section-eyebrow {
  display: inline-block;
  font-size: 0.8em;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 15px;
  font-weight: 600;
}
.section-title {
  font-family: 'Playfair Display', serif;
  font-size: 2.8em;
  color: var(--primary);
  margin-bottom: 15px;
  font-weight: 900;
  letter-spacing: -1px;
  line-height: 1.1;
}
.section-subtitle {
  color: var(--text-muted);
  font-size: 1.05em;
  font-weight: 300;
  line-height: 1.8;
}
.modules-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
  gap: 20px;
  margin-bottom: 80px;
}
.module-card {
  background: white;
  border-radius: 14px;
  padding: 35px;
  cursor: pointer;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1px solid var(--border);
  position: relative;
  overflow: hidden;
}
.module-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 4px; height: 100%;
  background: var(--primary);
  transition: width 0.3s;
}
.module-card:nth-child(2)::before { background: var(--secondary); }
.module-card:nth-child(3)::before { background: var(--accent); }
.module-card:nth-child(4)::before { background: #2f855a; }
.module-card:nth-child(5)::before { background: #805ad5; }
.module-card:nth-child(6)::before { background: #3182ce; }
.module-card:nth-child(7)::before { background: #d69e2e; }
.module-card:nth-child(8)::before { background: #c53030; }
.module-card:nth-child(9)::before { background: #2b6cb0; }
.module-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 15px 40px rgba(0,0,0,0.1);
}
.module-card:hover::before { width: 6px; }
.module-number {
  font-family: 'Playfair Display', serif;
  font-size: 2.5em;
  font-weight: 900;
  color: var(--border);
  line-height: 1;
  margin-bottom: 15px;
  transition: color 0.3s;
}
.module-card:hover .module-number { color: var(--accent); }
.module-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.6em;
  color: var(--primary);
  margin-bottom: 10px;
  font-weight: 700;
  letter-spacing: -0.5px;
}
.module-subtitle {
  color: var(--text-muted);
  font-size: 0.95em;
  font-weight: 400;
  margin-bottom: 20px;
  line-height: 1.6;
}
.module-arrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--primary);
  font-weight: 600;
  font-size: 0.85em;
  letter-spacing: 1px;
  text-transform: uppercase;
  transition: gap 0.3s;
}
.module-card:hover .module-arrow { gap: 12px; }
.module-arrow svg { width: 16px; height: 16px; transition: transform 0.3s; }
.module-card:hover .module-arrow svg { transform: translateX(4px); }
.module-view { display: none; animation: fadeIn 0.4s ease; }
.module-view.active { display: block; }
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(15px); }
  to { opacity: 1; transform: translateY(0); }
}
.module-header-view {
  padding-bottom: 35px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 40px;
}
.module-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--text-muted);
  font-size: 0.9em;
  font-weight: 500;
  cursor: pointer;
  margin-bottom: 25px;
  transition: color 0.3s;
  background: none;
  border: none;
  font-family: inherit;
}
.module-back:hover { color: var(--primary); }
.module-back svg { width: 16px; height: 16px; }
.module-title-view {
  font-family: 'Playfair Display', serif;
  font-size: 3.2em;
  color: var(--primary);
  margin-bottom: 12px;
  font-weight: 900;
  letter-spacing: -1px;
  line-height: 1.1;
}
.module-subtitle-view {
  color: var(--text-muted);
  font-size: 1.15em;
  font-weight: 300;
}
.module-intro {
  font-size: 1.1em;
  color: var(--text-light);
  line-height: 1.8;
  margin-bottom: 45px;
  max-width: 800px;
  font-weight: 400;
}
.module-intro strong { color: var(--primary); font-weight: 700; }
.signs-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
  gap: 25px;
  margin-bottom: 50px;
}
.sign-card { text-align: center; transition: transform 0.3s; }
.sign-card:hover { transform: translateY(-4px); }
.sign-image {
  width: 100%;
  aspect-ratio: 1;
  background: white;
  border-radius: 12px;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0,0,0,0.06);
  border: 1px solid var(--border);
}
.sign-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s;
}
.sign-card:hover .sign-image img { transform: scale(1.06); }
.sign-letter {
  font-family: 'Playfair Display', serif;
  font-size: 1.7em;
  font-weight: 900;
  color: var(--primary);
  margin-bottom: 6px;
  letter-spacing: -0.5px;
}
.sign-desc {
  font-size: 0.85em;
  color: var(--text-muted);
  line-height: 1.5;
  font-weight: 400;
}
.module-navigation {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 35px;
  border-top: 1px solid var(--border);
  margin-top: 50px;
}
.nav-button {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 22px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 10px;
  cursor: pointer;
  transition: all 0.3s;
  font-family: inherit;
  font-size: 0.9em;
  font-weight: 600;
  color: var(--primary);
}
.nav-button:hover {
  background: var(--primary);
  color: white;
  border-color: var(--primary);
  transform: translateY(-2px);
}
.nav-button svg { width: 16px; height: 16px; }
.nav-button.disabled { opacity: 0.3; cursor: not-allowed; }
.nav-button.disabled:hover { background: white; color: var(--primary); transform: none; }
.nav-center { color: var(--text-muted); font-size: 0.85em; font-weight: 500; }
.sabias-que {
  background: var(--primary);
  color: white;
  padding: 80px 40px;
  margin: 0 -40px;
}
.sabias-que .section-eyebrow { color: var(--accent-light); }
.sabias-que .section-title { color: white; }
.sabias-que .section-subtitle { color: rgba(255,255,255,0.7); }
.facts-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 35px;
  margin-top: 50px;
}
.fact-item { padding: 25px 0; border-top: 1px solid rgba(255,255,255,0.1); }
.fact-number {
  font-family: 'Playfair Display', serif;
  font-size: 2.5em;
  color: var(--accent-light);
  font-weight: 900;
  line-height: 1;
  margin-bottom: 12px;
}
.fact-title { font-size: 1.15em; font-weight: 700; margin-bottom: 10px; color: white; }
.fact-text { color: rgba(255,255,255,0.7); font-size: 0.92em; line-height: 1.7; font-weight: 300; }
.info-section { margin-top: 80px; }
.timeline { margin-top: 50px; }
.timeline-item {
  display: grid;
  grid-template-columns: 180px 1fr;
  gap: 35px;
  padding: 35px 0;
  border-bottom: 1px solid var(--border);
  align-items: start;
}
.timeline-item:first-child { border-top: 1px solid var(--border); }
.timeline-label {
  font-family: 'Playfair Display', serif;
  font-size: 1.2em;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: -0.5px;
}
.timeline-text { color: var(--text-light); font-size: 1em; line-height: 1.8; font-weight: 400; }
footer {
  background: var(--primary);
  color: white;
  padding: 60px 40px 30px;
  margin-top: 80px;
}
.footer-content { max-width: 1200px; margin: 0 auto; text-align: center; }
.footer-flag {
  display: inline-block;
  width: 50px; height: 5px;
  background: linear-gradient(to right, #FFD700 33%, #003893 33%, #003893 66%, #CF142B 66%);
  margin-bottom: 25px;
  border-radius: 3px;
}
footer h3 { font-family: 'Playfair Display', serif; font-size: 1.6em; margin-bottom: 12px; font-weight: 700; }
footer p { opacity: 0.7; font-size: 0.9em; font-weight: 300; margin: 6px 0; }
.footer-bottom { margin-top: 40px; padding-top: 25px; border-top: 1px solid rgba(255,255,255,0.1); font-size: 0.8em; opacity: 0.5; }
@media (max-width: 768px) {
  header { padding: 0 20px; height: 60px; }
  .hero { padding: 120px 20px 60px; }
  .hero h1 { font-size: 2.3em; }
  .container { padding: 50px 20px; }
  .section-title { font-size: 2em; }
  .modules-grid { grid-template-columns: 1fr; }
  .module-title-view { font-size: 2.3em; }
  .signs-grid { grid-template-columns: repeat(2, 1fr); gap: 15px; }
  .timeline-item { grid-template-columns: 1fr; gap: 10px; }
  .sabias-que { margin: 0 -20px; padding: 50px 20px; }
  footer { padding: 50px 20px 25px; }
  .module-navigation { flex-direction: column; gap: 12px; }
  .nav-center { display: none; }
  .side-panel { width: 100%; max-width: 100%; right: -100%; }
}
</style>
</head>
<body>

<header id="main-header">
  <div class="logo" onclick="goHome()">
    <div class="logo-flag">
      <svg viewBox="0 0 90 60" width="100%" height="100%">
        <rect width="90" height="20" fill="#FFCC00"/>
        <rect y="20" width="90" height="20" fill="#00247D"/>
        <rect y="40" width="90" height="20" fill="#CF142B"/>
        <g fill="white">
          <circle cx="25" cy="32" r="1.5"/><circle cx="32" cy="28" r="1.5"/><circle cx="40" cy="26" r="1.5"/><circle cx="45" cy="25.5" r="1.5"/><circle cx="50" cy="25.5" r="1.5"/><circle cx="58" cy="26" r="1.5"/><circle cx="66" cy="28" r="1.5"/><circle cx="73" cy="32" r="1.5"/>
        </g>
      </svg>
    </div>
    <span>LSV</span>
  </div>
  <button class="menu-btn" id="menuBtn" onclick="togglePanel()">
    <span></span><span></span><span></span>
  </button>
</header>

<div class="panel-overlay" id="panelOverlay" onclick="togglePanel()"></div>
<div class="side-panel" id="sidePanel">
  <div class="panel-header">
    <h3>Índice de Contenidos</h3>
    <button class="panel-close" onclick="togglePanel()">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="panel-content">
    <div class="panel-item" onclick="goHome(); togglePanel();">
      <div class="panel-item-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      </div>
      <div>
        <div class="panel-item-text">Inicio</div>
        <div class="panel-item-sub">Página principal</div>
      </div>
    </div>
    <div class="panel-divider"></div>
    <div class="panel-item" onclick="toggleSubmenu()">
      <div class="panel-item-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
      </div>
      <div style="flex:1;">
        <div class="panel-item-text">Módulos</div>
        <div class="panel-item-sub">9 módulos de aprendizaje</div>
      </div>
      <svg id="submenuArrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="transition:transform 0.3s;"><polyline points="6 9 12 15 18 9"/></svg>
    </div>
    <div class="panel-submenu" id="modulesSubmenu"></div>
    <div class="panel-divider"></div>
    <div class="panel-item" onclick="scrollToSection('sabias-que'); togglePanel();">
      <div class="panel-item-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 22h4M12 2a7 7 0 00-4 12.7V17h8v-2.3A7 7 0 0012 2z"/></svg>
      </div>
      <div>
        <div class="panel-item-text">¿Sabías que...?</div>
        <div class="panel-item-sub">Datos interesantes</div>
      </div>
    </div>
    <div class="panel-item" onclick="scrollToSection('informacion'); togglePanel();">
      <div class="panel-item-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
      </div>
      <div>
        <div class="panel-item-text">Información</div>
        <div class="panel-item-sub">Contexto sobre la LSV</div>
      </div>
    </div>
    <div class="panel-item" onclick="scrollToSection('contacto'); togglePanel();">
      <div class="panel-item-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      </div>
      <div>
        <div class="panel-item-text">Contacto</div>
        <div class="panel-item-sub">Pie de página</div>
      </div>
    </div>
  </div>
</div>

<section class="hero">
  <div class="hero-content">
    <span class="eyebrow">Plataforma Educativa</span>
    <h1>Lengua de Señas <em>Venezolana</em></h1>
    <div class="hero-stats">
      <div class="stat"><span class="stat-number">27</span><span class="stat-label">Letras</span></div>
      <div class="stat"><span class="stat-number">9</span><span class="stat-label">Módulos</span></div>
      <div class="stat"><span class="stat-number">100%</span><span class="stat-label">Gratuito</span></div>
    </div>
  </div>
</section>

<div class="container" id="modulos">
  <div id="home-view">
