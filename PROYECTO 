let currentModuleIndex = -1;

function renderModulesGrid() {
  const grid = document.getElementById('modules-grid');
  modulesData.forEach((mod, index) => {
    const card = document.createElement('div');
    card.className = 'module-card';
    card.onclick = () => openModule(index);
    card.innerHTML = `
      <div class="module-number">${mod.number}</div>
      <h3 class="module-title">${mod.title}</h3>
      <p class="module-subtitle">${mod.subtitle}</p>
      <div class="module-arrow">
        Explorar
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </div>
    `;
    grid.appendChild(card);
  });
}

function renderSubmenu() {
  const submenu = document.getElementById('modulesSubmenu');
  modulesData.forEach((mod, index) => {
    const item = document.createElement('div');
    item.className = 'panel-sub-item';
    item.onclick = () => { openModule(index); togglePanel(); };
    item.innerHTML = `<span class="sub-number">${mod.number}</span><span>${mod.title}</span>`;
    submenu.appendChild(item);
  });
}

function openModule(index) {
  savedScrollPosition = window.pageYOffset;
  currentModuleIndex = index;
  const mod = modulesData[index];
  
  document.getElementById('home-view').style.display = 'none';
  document.getElementById('module-view').classList.add('active');
  
  document.getElementById('view-title').textContent = mod.title;
  document.getElementById('view-subtitle').textContent = mod.subtitle;
  document.getElementById('view-intro').innerHTML = mod.intro;
  
  const signsGrid = document.getElementById('view-signs');
  signsGrid.innerHTML = '';
  
  mod.signs.forEach(sign => {
    const card = document.createElement('div');
    card.className = 'sign-card';
    let imgHTML;
    if (sign.img) {
      imgHTML = `<img src="${sign.img}" alt="${sign.letter}" onerror="this.parentElement.innerHTML='<div style=\\'font-size:2.5em;font-family:Playfair Display,serif;color:${sign.color || 'var(--primary)'}\\'>${sign.letter}</div>'">`;
    } else {
      imgHTML = `<div style="font-size:2.5em;font-family:'Playfair Display',serif;color:${sign.color || 'var(--primary)'}">${sign.letter}</div>`;
    }
    card.innerHTML = `<div class="sign-image">${imgHTML}</div><div class="sign-letter">${sign.letter}</div><div class="sign-desc">${sign.desc}</div>`;
    signsGrid.appendChild(card);
  });
  
  document.getElementById('nav-counter').textContent = `${mod.number} / ${modulesData.length}`;
  document.getElementById('nav-prev').classList.toggle('disabled', index === 0);
  document.getElementById('nav-next').classList.toggle('disabled', index === modulesData.length - 1);
  
  history.pushState({ module: index }, '', `#modulo-${mod.id}`);
  
  setTimeout(() => {
    const moduleView = document.getElementById('module-view');
    const headerHeight = document.getElementById('main-header').offsetHeight;
    const targetPosition = moduleView.getBoundingClientRect().top + window.pageYOffset - headerHeight;
    window.scrollTo(0, targetPosition);
    document.documentElement.scrollTop = targetPosition;
    document.body.scrollTop = targetPosition;
  }, 20);
}

function goHome() {
  document.getElementById('home-view').style.display = 'block';
  document.getElementById('module-view').classList.remove('active');
  currentModuleIndex = -1;
  history.pushState({ home: true }, '', window.location.pathname);
  setTimeout(() => {
    window.scrollTo(0, savedScrollPosition);
    document.documentElement.scrollTop = savedScrollPosition;
    document.body.scrollTop = savedScrollPosition;
  }, 20);
}

function goBack() { goHome(); }

function navigateModule(direction) {
  const newIndex = currentModuleIndex + direction;
  if (newIndex >= 0 && newIndex < modulesData.length) {
    openModule(newIndex);
  }
}

window.addEventListener('popstate', (e) => {
  if (e.state && e.state.module !== undefined) {
    openModule(e.state.module);
  } else {
    goHome();
  }
});

renderModulesGrid();
renderSubmenu();
history.replaceState({ home: true }, '', window.location.pathname);
</script>

